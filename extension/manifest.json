{
  "manifest_version": 3,
  "name": "File Download for Google Classroom",
  "version": "1.2.0",
  "description": "Google Classroom の配布資料（PDF・Word など）をワンクリックで保存。One-click download for files shared in Google Classroom.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://classroom.google.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "all_frames": true,
      "js": [
        "viewer.js"
      ],
      "matches": [
        "https://drive.google.com/viewer/*",
        "https://drive.google.com/viewerng/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://docs.google.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "permissions": [
    "downloads"
  ]
}
